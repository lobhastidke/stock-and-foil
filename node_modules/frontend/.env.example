# =====================================================================
# Stock & Foil — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.
# =====================================================================

# Set to 'true' to use the in-memory mock layer (no backend needed).
# The mock behaves exactly like the real API including DUPLICATE_PLEDGE.
VITE_USE_MOCK=true

# Backend API base path. Only change for non-standard deployments.
# On Vercel, the built SPA calls /api/v1 on the same origin automatically.
VITE_API_BASE=/api/v1

# Optional: MST blockchain explorer transaction URL template.
# When set AND chainMode is HARDHAT or MST_TESTNET AND blockchainStatus
# is CONFIRMED, the UI will show a clickable tx link.
# Example: https://explorer.mst.network/tx/
# Leave BLANK until you have a VERIFIED MST explorer URL.
# DO NOT guess or invent this URL (see HARD RULES in docs/AGENTS.md).
VITE_EXPLORER_TX_URL=
