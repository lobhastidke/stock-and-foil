# Server environment
NODE_ENV=development
PORT=3001

# Database (leave empty to use in-process PGlite for local development/testing)
DATABASE_URL=

# Authentication & Security
# Generate with: openssl rand -hex 32
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Exactly 32 bytes in hex (64 hex characters) for AES-256-GCM encryption of salts and documents
DOC_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Secret token for background Vercel cron reconciliation (/api/v1/internal/reconcile)
CRON_SECRET=stockfoil_dev_cron_secret_12345

# Blockchain Mode (MOCK | HARDHAT | MST_TESTNET)
# For MST Testnet:
# CHAIN_MODE=MST_TESTNET
# CHAIN_RPC_URL=https://testnetrpc.mstblockchain.com
# CHAIN_ID=91562037
# CONTRACT_ADDRESS=0x9a1559F1bCc8dd80c34a1F4706c66d897722dfEE
# OPERATOR_PRIVATE_KEY=<your_operator_private_key>
CHAIN_MODE=MOCK
CHAIN_RPC_URL=
CHAIN_ID=
CONTRACT_ADDRESS=
OPERATOR_PRIVATE_KEY=

# Frontend API base path
VITE_API_BASE=/api/v1
