# Server environment
NODE_ENV=production
PORT=3001

# Database (PostgreSQL URL e.g. from Supabase/Neon/Vercel Postgres; empty = PGlite local)
DATABASE_URL=

# Authentication & Encryption Keys (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_64_hex_chars_random_secret
DOC_ENCRYPTION_KEY=replace_with_64_hex_chars_encryption_key
CRON_SECRET=replace_with_cron_reconciliation_secret

# Blockchain Mode (MOCK | HARDHAT | MST_TESTNET)
# For MST Testnet:
# CHAIN_MODE=MST_TESTNET
# CHAIN_RPC_URL=https://testnetrpc.mstblockchain.com
# CHAIN_ID=91562037
# CONTRACT_ADDRESS=0x9a1559F1bCc8dd80c34a1F4706c66d897722dfEE
# OPERATOR_PRIVATE_KEY=<your_operator_private_key>
CHAIN_MODE=MOCK
CHAIN_RPC_URL=
CHAIN_ID=
CONTRACT_ADDRESS=
OPERATOR_PRIVATE_KEY=

# Frontend API base path
VITE_API_BASE=/api/v1
